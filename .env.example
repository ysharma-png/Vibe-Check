# ==============================================================================
# CacheFlow Production & Development Environment Variables Template
# Copy this file to .env.local for local development. NEVER commit real values.
# In Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC CLIENT VARIABLES (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------

# Public: The canonical base URL of your site (e.g., https://your-project.vercel.app or http://localhost:3000)
# Where to get it: Vercel deployment URL or custom domain
NEXT_PUBLIC_SITE_URL=

# Public: Alias for application URL (used in metadata & OpenGraph generators)
# Where to get it: Same as NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_APP_URL=

# Public: Your Supabase Project HTTPS endpoint URL
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public: Safe for browser usage. Grants anonymous access governed by Row Level Security (RLS)
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' / 'public'
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public: Enable demo account instant login buttons on the login screen ('true' or 'false')
# Where to get it: Set to 'true' for preview/demo builds; set to 'false' for strict production
NEXT_PUBLIC_DEMO_MODE=

# Public: Toggle bot protection challenge ('true' or 'false')
# Where to get it: Set to 'false' by default, or 'true' if Cloudflare Turnstile is configured
NEXT_PUBLIC_ENABLE_CAPTCHA=


# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (STRICT: NEVER expose to the browser or commit)
# ------------------------------------------------------------------------------

# Server-only: Elevated privileges client used only by secure server API routes (bypasses RLS)
# Where to get it: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'service_role' (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: API key for Google Gemini model used by the AI Brief Builder route
# Where to get it: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Server-only: (Optional) Distributed sliding-window rate limiting endpoint
# Where to get it: Upstash Console (https://console.upstash.com) -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=

# Server-only: (Optional) Distributed sliding-window rate limiting token
# Where to get it: Upstash Console (https://console.upstash.com) -> Redis Database -> REST API
UPSTASH_REDIS_REST_TOKEN=
